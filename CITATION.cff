cff-version: 1.2.0
message: "If you use scopusflow, please cite it as below."
title: "scopusflow: A reproducible workflow layer for 'Scopus' bibliographic searches"
abstract: "A quota-aware workflow layer over the Elsevier 'Scopus' Search API. It builds reproducible search plans, retrieves records with rate-limit handling and resumable caching, normalises results to a stable tidy schema, tracks changes in DOI sets over time, compares publication trends across topics and exports to downstream bibliometric tools."
type: software
authors:
  - family-names: Bernabeu
    given-names: Pablo
    orcid: "https://orcid.org/0000-0003-1083-2460"
    email: pcbernabeu@gmail.com
version: "0.4.0"
# The date CRAN published 0.4.0.
date-released: "2026-08-21"
# The DOI CRAN assigned to the package on publication. It identifies the package
# across all its versions, so the version above pins the release.
doi: "10.32614/CRAN.package.scopusflow"
# Both DOIs, since doi holds one. Zenodo's concept DOI resolves to the latest
# archived GitHub release.
identifiers:
  - type: doi
    value: "10.32614/CRAN.package.scopusflow"
    description: "The R package on CRAN, across all its versions."
  - type: doi
    value: "10.5281/zenodo.21252669"
    description: "Every GitHub release of the repository, archived on Zenodo."
license: MIT
repository-code: "https://github.com/pablobernabeu/scopusflow"
# CRAN distributes the built package, which is what CFF's repository-artifact
# field is for. The sources are on GitHub, in repository-code above.
repository-artifact: "https://CRAN.R-project.org/package=scopusflow"
url: "https://pablobernabeu.github.io/scopusflow/"
keywords:
  - bibliometrics
  - Scopus
  - literature search
  - reproducible research
  - quota-aware retrieval
